import sys
import pdf2zh.pdf2zh

WAIT_FOR_INPUT = False
if len(sys.argv) == 1:
    sys.argv.append("-i")  # 无参数时自动添加 -i 参数
    WAIT_FOR_INPUT = True

try:
    code = pdf2zh.pdf2zh.main()
    print(f"pdf2zh.pdf2zh.main() return code: {code}")
    if WAIT_FOR_INPUT:
        input("Press Enter to continue...")
    sys.exit(code)
except Exception:
    import traceback
    traceback.print_exc()
    if WAIT_FOR_INPUT:
        input("Press Enter to continue...")
    sys.exit(1)